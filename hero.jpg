<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" fill="none">
  <defs>
    <linearGradient id="heroSky" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F8FAFC"/>
      <stop offset="60%" stop-color="#E2E8F0"/>
      <stop offset="100%" stop-color="#CBD5E1"/>
    </linearGradient>
    <linearGradient id="glassWall" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#F1F5F9" stop-opacity="0.4"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#heroSky)"/>
  
  <!-- Architectural Clinic Window Frames -->
  <line x1="200" y1="0" x2="200" y2="675" stroke="#E2E8F0" stroke-width="4"/>
  <line x1="600" y1="0" x2="600" y2="675" stroke="#E2E8F0" stroke-width="4"/>
  <line x1="1000" y1="0" x2="1000" y2="675" stroke="#E2E8F0" stroke-width="4"/>
  <line x1="0" y1="280" x2="1200" y2="280" stroke="#E2E8F0" stroke-width="3"/>

  <!-- High-End Clinic Room Desk & Equipment -->
  <!-- Floor -->
  <path d="M0 480l1200 -80v275H0z" fill="#E2E8F0" opacity="0.6"/>
  <path d="M0 520l1200 -60v215H0z" fill="#CBD5E1" opacity="0.4"/>

  <!-- Examination Chair Area -->
  <g transform="translate(680, 200)">
    <!-- Base -->
    <ellipse cx="220" cy="400" rx="90" ry="24" fill="#64748B" opacity="0.5"/>
    <rect x="205" y="320" width="30" height="80" rx="6" fill="#94A3B8"/>
    <!-- Seat & Backrest in Teal / Medical Cyan -->
    <rect x="150" y="290" width="140" height="35" rx="12" fill="#008080"/>
    <rect x="155" y="140" width="130" height="150" rx="16" fill="#005A9C"/>
    <rect x="180" y="90" width="80" height="45" rx="10" fill="#0284C7"/>
    <!-- Armrests -->
    <rect x="125" y="240" width="30" height="70" rx="8" fill="#475569"/>
    <rect x="285" y="240" width="30" height="70" rx="8" fill="#475569"/>
  </g>

  <!-- ENT Diagnostic Tower & Screen -->
  <g transform="translate(360, 240)">
    <rect x="80" y="80" width="150" height="280" rx="14" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="3"/>
    <!-- High-res HD Endoscope Screen -->
    <rect x="95" y="95" width="120" height="85" rx="8" fill="#0F172A"/>
    <path d="M105 140c10-20 25-10 40 5s30 10 45-15" stroke="#2ECC71" stroke-width="3" fill="none"/>
    <circle cx="160" cy="130" r="16" stroke="#008080" stroke-width="2" stroke-dasharray="3 3"/>
    <!-- Shelves & Equipment lights -->
    <rect x="95" y="195" width="120" height="25" rx="4" fill="#F1F5F9"/>
    <circle cx="110" cy="207" r="4" fill="#2ECC71"/>
    <circle cx="125" cy="207" r="4" fill="#0284C7"/>
    <circle cx="140" cy="207" r="4" fill="#F59E0B"/>
    <rect x="95" y="235" width="120" height="30" rx="4" fill="#E2E8F0"/>
    <rect x="95" y="280" width="120" height="40" rx="4" fill="#F8FAFC"/>
  </g>

  <!-- Soft Ambient Overlay -->
  <rect width="1200" height="675" fill="url(#glassWall)"/>

  <!-- Trust Floating Card -->
  <g transform="translate(100, 160)">
    <rect width="320" height="130" rx="16" fill="#FFFFFF" filter="drop-shadow(0 15px 25px rgba(0,33,71,0.08))"/>
    <circle cx="48" cy="48" r="24" fill="#E0F2FE"/>
    <path d="M40 48l6 6 12-12" stroke="#005A9C" stroke-width="3.5" stroke-linecap="round"/>
    <text x="86" y="42" font-family="'Inter', sans-serif" font-size="16" font-weight="700" fill="#002147">Modern ENT Diagnostics</text>
    <text x="86" y="62" font-family="'Roboto', sans-serif" font-size="12" fill="#4A5568">Rigid Endoscopy · Audiometry</text>
    <line x1="30" y1="84" x2="290" y2="84" stroke="#F1F5F9" stroke-width="2"/>
    <text x="30" y="106" font-family="'Roboto', sans-serif" font-size="12" font-weight="600" fill="#008080">✓ Compassionate &amp; Precise Care</text>
  </g>
</svg>
